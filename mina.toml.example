# /etc/mina.toml — Mina agent configuration
# Copy this file to /etc/mina.toml and adjust before running `mina install-pam`.

# Where bundles are assembled before they are shipped (top-level key: keep it
# above the first [table]). A bundle is removed from here once it has been
# shipped, and kept if shipping failed: it is then the only copy.
# Created with mode 0700 if missing. session-close refuses to write into a
# staging directory that is a symlink, not owned by root, or writable by
# group or other. Do not point it into /tmp or any other shared directory.
# staging_dir = "/var/lib/mina/staging"

[nest]
# Transport backend: "ssh" (default), "https", or "local".
#
# ssh   — ships bundles via rsync over SSH. No new ports required.
#         Requires a key at /etc/mina/nest_key (see README).
#
# https — POSTs a tarball to an HTTP endpoint. Use when port 22 is
#         blocked or the nest is behind a corporate firewall.
#         The endpoint MUST be HTTPS; plain HTTP is rejected.
#
# local — copies bundles into a local directory, readable by root only
#         (files 0400, directories 0500).
#         No network required. Useful when the nest is on the same machine,
#         or when testing without a remote endpoint.
#
transport = "ssh"

# SSH destination (required when transport = "ssh").
# Format: user@host:/path  — the path must be writable by that user.
ssh_destination = "mina@nest.example.com:/var/mina"

# HTTPS endpoint (required when transport = "https").
# https_endpoint = "https://nest.example.com/ingest"

# Optional: present a client certificate to the nest (mutual TLS).
# Both or neither. PEM; the cert file may hold the full chain, leaf first.
# The key must be unencrypted (PKCS#8, PKCS#1 or SEC1 PEM). Both files are
# read at every session close, so a renewed certificate is picked up.
# https_client_cert = "/etc/mina/client.crt"
# https_client_key  = "/etc/mina/client.key"

# Optional: verify the nest against this CA certificate (PEM, one or more
# certs) instead of the system CA store (/etc/ssl/certs, from the
# ca-certificates package). A machine without that store must set this.
# https_ca_cert = "/etc/mina/nest-ca.crt"

# Local destination (required when transport = "local").
# The directory is created automatically if it does not exist. Keep it
# closed to other users, e.g. `install -d -m 0750 -o root -g adm /var/mina`.
# local_destination = "/var/mina"


[capture]
# Files larger than this are skipped and noted in session.json (kilobytes).
# Raise this if you manage large config files (e.g. bundled certificates).
text_size_limit_kb = 512

# Path prefixes to never capture, regardless of what appears on the command
# line. Add any application-specific secret directories here.
skip_paths = [
    "/proc",
    "/sys",
    "/dev",
    "/tmp",
    "/run",
    # "/etc/ssl/private",   # example: skip private keys
]


[session]
# PAM services that open a mina session (the PAM_SERVICE pam_exec passes).
# "sshd" is SSH, "login" is the local console. Everything else is ignored,
# even when mina's pam_exec lines sit in a shared stack such as Debian's
# common-session: cron jobs, su, sudo, runuser and the systemd --user
# manager do not open a session of their own. Commands typed in a `su -` or
# `sudo -i` shell are logged into the login session they were started from.
pam_services = ["sshd", "login"]
